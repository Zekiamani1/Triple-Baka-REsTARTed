AUTH_JWT_PRIVATE_KEY_PATH=./keys/private.pem
AUTH_ACCESS_TOKEN_TTL_SECONDS=60
AUTH_REFRESH_TOKEN_TTL_SECONDS=86400
AUTH_PORT=8083
AUTH_ISSUER=bnpb-auth
CLIENT_MEDIA_SECRET=change-me
CLIENT_LAPANGAN_SECRET=change-me
CLIENT_INTERNAL_SECRET=change-me
AUTH_DB_DSN=postgres://auth_user:auth_pass@auth-db:5432/auth?sslmode=disable
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=auth_pass
POSTGRES_DB=auth
