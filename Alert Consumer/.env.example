KAFKA_BROKERS=kafka-aggregate:29092
KAFKA_CLIENT_ID=alert-consumer
KAFKA_CONSUMER_GROUP=emergency-notifier
KAFKA_CRITICAL_CONSUMER_GROUP=coastal-critical-notifier
KAFKA_TOPIC_HAZARD_EVENTS=hazard-events
KAFKA_TOPIC_HAZARD_CRITICAL=hazard-critical
KAFKA_FROM_BEGINNING=true
FIELD_RECEIVER_URL=http://field-receiver:8090/notifications
FIELD_RECEIVER_TOKEN=replace-with-secret
DELIVERY_TIMEOUT_MS=2000
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_BASE_BACKOFF_MS=250
DELIVERY_MAX_BACKOFF_MS=5000
HEALTH_PORT=8088
OTEL_SERVICE_NAME=alert-consumer
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4317
OTEL_METRIC_EXPORT_INTERVAL=10000
