KAFKA_BROKERS=kafka-aggregate:29092
KAFKA_CLIENT_ID=aggregate-service
KAFKA_CONSUMER_GROUP=aggregate-ingestion
KAFKA_TOPIC_HAZARD_INGEST=hazard-ingest
KAFKA_TOPIC_HAZARD_EVENTS=hazard-events
KAFKA_TOPIC_HAZARD_CRITICAL=hazard-critical
# Optional source restriction. aggregate-pantai overrides topic/group/source.
KAFKA_EXPECTED_SOURCE=
MONGO_URI=mongodb://mongo-router:27017
MONGO_DB_NAME=bnpb
MONGO_COLLECTION=hazard_events
# Optional internal adapter status endpoint. Without it, API responses report unavailable.
SENSOR_PANTAI_STATUS_URL=
SENSOR_PANTAI_STATUS_TIMEOUT_MS=250
AGGREGATOR_PORT=50051
OTEL_SERVICE_NAME=aggregate-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4317
