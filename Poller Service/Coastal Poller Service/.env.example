SENSOR_BASE_URL=http://sensor-pantai:8080
PANTAI_AUTH_TOKEN=replace-with-secret
POLL_INTERVAL_MS=1000
HTTP_TIMEOUT_MS=1000
BREAKER_FAILURE_THRESHOLD=3
BREAKER_OPEN_MS=10000
KAFKA_BROKERS=kafka-aggregate:29092
KAFKA_TOPIC_PANTAI_INGEST=pantai-ingest
KAFKA_TOPIC_PANTAI_QUARANTINE=pantai-quarantine
PANTAI_STATE_URI=replace-with-adapter-owned-durable-store-uri
HEALTH_PORT=8089
OTEL_SERVICE_NAME=sensor-pantai-adapter
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4317
MAX_OBSERVATION_AGE_MS=1800000
MAX_FUTURE_SKEW_MS=0